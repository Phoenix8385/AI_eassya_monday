# Copy to .env and adjust. Every value below has a working default in
# app/config.py; nothing here is required just to boot.

# --- HTTP -----------------------------------------------------------------
# Comma-separated list of allowed browser origins. Include every frontend that
# will call this API -- localhost during development, the deployed URL in
# production. No spaces are required around the commas; they are trimmed.
#   dev only : http://localhost:5173
#   dev+prod : http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Models ---------------------------------------------------------------
# Path to the trained classifier. Relative paths resolve against the backend
# root (the directory holding this file), not the shell's cwd. The artifact is
# gitignored -- regenerate it with `python -m scripts.train`.
MODEL_PATH=app/data/classifier.joblib

# HuggingFace repo id for the perplexity model.
GPT2_MODEL_NAME=openai-community/gpt2

# Optional: pin the HuggingFace cache somewhere persistent. On a container host
# with an ephemeral filesystem, set this to a mounted volume so GPT-2 is not
# re-downloaded on every deploy.
# HF_CACHE_DIR=/var/cache/huggingface

# Torch device: cpu | cuda | auto
TORCH_DEVICE=cpu

# Intra-op thread cap. 0 leaves torch's default. On a small shared host, 1 or 2
# keeps a single analysis from saturating every core.
TORCH_NUM_THREADS=0

# Run one tiny forward pass at boot so the first real request is not paying for
# torch's lazy kernel init.
WARMUP_ON_STARTUP=true

# --- Analysis -------------------------------------------------------------
# Accepted essay length, in characters. MIN_ESSAY_CHARS is also the schema
# constraint on the request body -- shorter submissions are rejected with a 422
# because perplexity and burstiness are too noisy to mean anything below it.
# MIN_ESSAY_CHARS is the cheap Pydantic gate (~250 chars ~ 50 words); the real
# limit is MIN_ESSAY_WORDS, enforced in the handler so the error can report the
# actual count. MAX_ESSAY_CHARS is deliberately loose so MAX_ESSAY_WORDS is the
# binding ceiling rather than dead code.
MIN_ESSAY_CHARS=250
MAX_ESSAY_CHARS=150000
MIN_ESSAY_WORDS=50
# Scoring time grows with length. 20000 is far above any real admissions essay;
# lower it on modest hardware, where even a few thousand words is a slow request.
MAX_ESSAY_WORDS=20000

# --- Rate limiting --------------------------------------------------------
# Per-client limit on /analyze. GPT-2 inference is CPU-heavy, so a few callers
# can saturate the process. In-memory and per-process: with N uvicorn workers
# the effective aggregate limit is roughly N x this. A courtesy limit that keeps
# one enthusiastic caller from degrading a demo, not an anti-abuse control.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_TRACKED_CLIENTS=10000

# Read the client IP from X-Forwarded-For. Leave false unless a trusted proxy
# sets it -- otherwise any caller can spoof the header and bypass the limit.
TRUST_FORWARDED_FOR=false

# GPT-2 scoring window and the overlap kept between windows, in tokens.
# The stride must be smaller than the window.
PERPLEXITY_WINDOW_TOKENS=1024
PERPLEXITY_WINDOW_STRIDE=512

# Per-sentence flagging. A sentence is flagged when its coefficient-weighted
# within-essay deviation reaches SENTENCE_FLAG_Z *and* the dominant signal's own
# raw z-score reaches SENTENCE_MIN_Z. Absolute, not a percentile: a uniform
# essay flags nothing, which a top-N% rule could never report. Both choices are
# justified in EVALUATION.md.
# Flags additionally require the ESSAY to have scored AI-leaning
# (>= AI_DECISION_THRESHOLD): a locally-odd sentence inside an essay the model
# scored as clearly human is not evidence of anything.
SENTENCE_FLAG_Z=1.5
SENTENCE_MIN_Z=1.0

# Below this many scoreable sentences the essay's own variance is too noisy to
# z-score against; sentence scores return null with an explicit reason.
MIN_SENTENCES_FOR_LOCALIZATION=4

# Per-sentence AI likelihood at or above which the resemblance phrase switches
# to its strongest wording. Separate from flagging above: this is the absolute
# corpus-calibrated score, that one is deviation from the essay's own norm.
SENTENCE_FLAG_THRESHOLD=0.65

# Sentence likelihood calibration. A sentence is scored by how many standard
# deviations more predictable it is than typical human writing. OFFSET is the
# margin it must clear before crossing 0.5 -- raise it to flag less, lower it to
# flag more. SLOPE controls how sharply the likelihood moves around that point.
SENTENCE_ZSCORE_OFFSET=1.0
SENTENCE_ZSCORE_SLOPE=1.4

# Essay-level probability separating the verdicts. Within +/-0.15 of this the
# verdict is reported as "mixed" rather than forced either way.
AI_DECISION_THRESHOLD=0.5

# Cap on how many per-sentence records come back in one response.
MAX_EXPLAINED_SENTENCES=200

# --- Ops ------------------------------------------------------------------
LOG_LEVEL=INFO
